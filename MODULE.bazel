"""optview2_bazel - Bazel integration for OptView2 (clang optimization-remark viewer)."""

module(
    name = "optview2_bazel",
    version = "0.1.0",
)

# Keep these versions conservative: Bzlmod picks the maximum requested version, so a
# higher version here could silently bump the dependency graph of a consuming project.
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_python", version = "1.4.1")

# ----------------------------------------------------------------------------
# OptView2 sources (https://github.com/OfekShilon/optview2).
# Consumers may redirect this to a local checkout, see README.md.
# ----------------------------------------------------------------------------
optview2 = use_extension("//optview2:extensions.bzl", "optview2")
use_repo(optview2, "optview2")

# ----------------------------------------------------------------------------
# Python dependencies of OptView2 (PyYAML + Pygments).
# Consumers that already have them in their own pip hub can redirect via
#   --@optview2_bazel//tools:pyyaml=@my_pypi//pyyaml
#   --@optview2_bazel//tools:pygments=@my_pypi//pygments
# ----------------------------------------------------------------------------
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # Download wheels through the Bazel downloader so that --downloader_config mirrors apply.
    experimental_index_url = "https://pypi.org/simple",
    hub_name = "optview2_bazel_pypi",
    python_version = "3.12",
    requirements_lock = "//tools:requirements_lock.txt",
)
use_repo(pip, "optview2_bazel_pypi")
